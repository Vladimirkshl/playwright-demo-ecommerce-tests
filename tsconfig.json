{
  "compilerOptions": {
    "lib": ["ES2021", "DOM"],
    "skipLibCheck": true,
    "paths": {
      "@api/*": ["./api/*"],
      "@db/*": ["./db/*"],
      "@constants/*": ["./constants/*"],
      "@elements/*": ["./elements/*"],
      "@pages/*": ["./pages/*"],
      "@playwrightConfig": ["./playwright.config.ts"],
      "@fake/*": ["./fake/*"],
      "@test": ["./fixtures/base.fixture"],
      "@fixtures/*": ["./fixtures/*"],
      "@utils/*": ["./utils/*"],
    },
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
  }
}